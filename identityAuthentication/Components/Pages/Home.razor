@page "/"
@using Microsoft.AspNetCore.Authorization
@using identityAuthentication.Services
@inject OllamaChatService ChatService
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="text-center p-4 p-md-5">
            <img src="images/Logo.png" alt="Mascote do Sistema" class="home-logo mb-4" />
            
            <h1 class="display-5 fw-bold text-primary">Bem-vindo ao Portal de Suporte</h1>
            <p class="fs-5 text-muted mb-4">
                Acesse sua conta para abrir novos chamados ou acompanhar suas solicitações.
            </p>
            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                <a href="Account/Login" class="btn btn-primary btn-lg px-4 gap-3">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Entrar
                </a>
                <a href="Account/Register" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="fa-solid fa-user-plus me-1"></i> Criar Conta
                </a>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="container-fluid py-3">
            <h1 class="display-6 fw-normal mb-3 text-center">
                Bem-vindo, @context.User.Identity?.Name!
            </h1>
            <p class="fs-5 text-muted mb-4 text-center">
                O que você gostaria de fazer?
            </p>

            <div class="row g-4 mb-4 justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <div class="chat-wrapper">
                        <div class="chat-header">
                            <h5>
                                <img src="images/Logo.png" class="chat-logo" alt="Logo" /> 
                                Assistente Ed IV
                            </h5>
                            <span>Assistente Virtual</span>
                        </div>
                        <div class="chat-messages" id="chat-container">
                            @foreach (var msg in _mensagens)
                            {
                                <div class="message @msg.CssClass">
                                    @msg.Texto
                                </div>
                            }
                            @if (_processando)
                            {
                                <div class="message assistente">
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    Digitando...
                                </div>
                            }
                        </div>
                        <div class="chat-input-area">
                            <input @bind="_perguntaAtual" 
                                   @onkeydown="HandleEnter" 
                                   placeholder="Pergunte sobre o sistema..." 
                                   class="form-control" 
                                   disabled="@_processando" />
                            <button @onclick="EnviarPergunta" class="btn btn-primary" disabled="@_processando">
                                <i class="fa-solid fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center p-4">
                            <i class="fa-solid fa-circle-plus fa-3x text-primary mb-3"></i>
                            <h4 class="card-title">Abrir Novo Chamado</h4>
                            <p class="card-text">
                                Descreva seu problema ou solicitação e nossa equipe irá ajudar.
                            </p>
                            <a href="/novochamado" class="btn btn-outline-primary stretched-link mt-2">
                                Iniciar Solicitação
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center p-4">
                            <i class="fa-solid fa-ticket fa-3x text-secondary mb-3"></i>
                            <h4 class="card-title">Meus Tickets</h4>
                            <p class="card-text">
                                Acompanhe o status dos seus chamados abertos ou veja seu histórico.
                            </p>
                            <a href="/tickets" class="btn btn-outline-secondary stretched-link mt-2">
                                Ver Meus Tickets
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center p-4">
                            <i class="fa-solid fa-circle-question fa-3x text-info mb-3"></i>
                            <h4 class="card-title">FAQs</h4>
                            <p class="card-text">
                                Encontre respostas rápidas para os problemas mais comuns.
                            </p>
                            <a href="/faqs" class="btn btn-outline-info stretched-link mt-2">
                                Consultar FAQs
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <AuthorizeView Roles="Admin" Context="adminContext">
                <Authorized>
                    <hr class="my-4" />
                    <div class="p-3 bg-light rounded-3 text-center">
                        <h4 class="fw-bold">
                            <i class="fa-solid fa-user-shield me-2"></i> Opções do Administrador
                        </h4>
                        <p class="text-muted">Acesso rápido às áreas de gerenciamento do sistema.</p>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <a href="/painel" class="btn btn-outline-dark">
                                <i class="fa-solid fa-chart-pie me-1"></i> Painel
                            </a>
                            <a href="/estatisticas" class="btn btn-outline-dark">
                                <i class="fa-solid fa-chart-bar me-1"></i> Estatísticas
                            </a>
                            <a href="/relatorios" class="btn btn-outline-dark">
                                <i class="fa-solid fa-file-lines me-1"></i> Relatórios
                            </a>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private class MensagemChat
    {
        public string Texto { get; set; } = string.Empty;
        public bool EnviadoPorUsuario { get; set; }
        public string CssClass => EnviadoPorUsuario ? "usuario" : "assistente";
    }

    private List<MensagemChat> _mensagens = new();
    private string _perguntaAtual = string.Empty;
    private bool _processando = false;

    protected override void OnInitialized()
    {
        _mensagens.Add(new MensagemChat 
        { 
            Texto = "Olá! Como posso ajudar você a usar o sistema de chamados hoje?", 
            EnviadoPorUsuario = false 
        });
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnviarPergunta();
        }
    }

    private async Task EnviarPergunta()
    {
        if (string.IsNullOrWhiteSpace(_perguntaAtual) || _processando)
            return;

        var pergunta = _perguntaAtual;
        _perguntaAtual = string.Empty;
        _mensagens.Add(new MensagemChat { Texto = pergunta, EnviadoPorUsuario = true });
        
        _processando = true;
        StateHasChanged();

        try
        {
            string resposta = await ChatService.GerarRespostaSimplesAsync(pergunta);

            _mensagens.Add(new MensagemChat { Texto = resposta, EnviadoPorUsuario = false });
        }
        catch (Exception ex)
        {
            _mensagens.Add(new MensagemChat { Texto = $"Erro ao contatar a IA: {ex.Message}", EnviadoPorUsuario = false });
        }
        finally
        {
            _processando = false;
            StateHasChanged();
        }
    }
}